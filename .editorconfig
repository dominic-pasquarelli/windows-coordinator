# Windows Coordinator — editor and code-style configuration
#
# One place where "how the code looks" is decided, so it is never decided again in review. Two
# non-obvious things to know before editing this file:
#
#  1. These rules are IDE-level, not build-level. `Directory.Build.props` deliberately leaves
#     `EnforceCodeStyleInBuild` off, because the same file sets `TreatWarningsAsErrors=true` — with
#     both on, a formatting preference becomes a broken build, and a gate that fails for reasons
#     unrelated to correctness is a gate people learn to route around.
#  2. Nothing here has ever been applied by a real formatter. No .NET SDK existed in the environment
#     this repository was bootstrapped in, so `dotnet format` has never run against these rules.
#     Expect to correct them the first time it does (docs/NEXT.md — Active focus).

root = true

# ── every file ───────────────────────────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Batch launchers are parsed line by line by cmd.exe, which is unhappy with bare LF endings in some
# constructs. `coord.cmd` is the one that matters.
[*.{cmd,bat}]
end_of_line = crlf

[*.{md,markdown}]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown; stripping them silently reflows a doc.
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,xml,csproj,props,targets,axaml,xaml,resx,ps1}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

# ── C# ───────────────────────────────────────────────────────────────────────────────────────────
[*.cs]
indent_size = 4

# Usings: sorted, System first, no blank-line grouping. Sorted imports make a diff show what
# actually changed, and the `boundary` check in tools/doc-audit reads `using` directives as text —
# so keeping them tidy keeps the modularity check legible.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# File-scoped namespaces. One namespace per file is already the rule; the block form then buys
# nothing but an indent level on every line in the repository.
csharp_style_namespace_declarations = file_scoped:warning

# `var` when the type is already obvious from the right-hand side, explicit otherwise. The point is
# that a reader can name the type without leaving the line.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Braces always, even on one-line bodies: the class of bug where a second statement is added to an
# unbraced `if` is cheap to eliminate and expensive to find.
csharp_prefer_braces = true:warning

# Expression-bodied members where they genuinely read better — small accessors and one-line methods.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# Modern pattern/null idioms — these are not fashion; each removes a place a null can be missed.
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# `using var` over an explicit block where the scope is the whole method.
csharp_prefer_simple_using_statement = true:suggestion

# Layout
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_preserve_single_line_blocks = true

# ── naming ───────────────────────────────────────────────────────────────────────────────────────
# These are the conventions the whole codebase is written to. They are `warning`, not `error`: see
# the header — style is corrected, not enforced by failing a build.

# Interfaces begin with I.
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = any_interface
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_symbols.any_interface.applicable_kinds = interface
dotnet_naming_symbols.any_interface.applicable_accessibilities = *
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Types and non-field members are PascalCase.
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = any_type
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_symbols.any_type.applicable_kinds = class, struct, enum, delegate, type_parameter
dotnet_naming_symbols.any_type.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_rule.members_are_pascal_case.symbols = any_member
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_symbols.any_member.applicable_kinds = property, method, event, namespace
dotnet_naming_symbols.any_member.applicable_accessibilities = *

# Constants are PascalCase, including private ones — a capability id constant is read far more often
# than it is written, and SCREAMING_CASE buys nothing here.
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_rule.constants_are_pascal_case.symbols = any_constant
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_symbols.any_constant.applicable_kinds = field
dotnet_naming_symbols.any_constant.required_modifiers = const
dotnet_naming_symbols.any_constant.applicable_accessibilities = *

# Private instance fields are _camelCase, so a field is distinguishable from a local at a glance
# without `this.` on every line.
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_field
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel_case
dotnet_naming_symbols.private_field.applicable_kinds = field
dotnet_naming_symbols.private_field.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Parameters and locals are camelCase.
dotnet_naming_rule.parameters_are_camel_case.severity = warning
dotnet_naming_rule.parameters_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_are_camel_case.style = camel_case
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_symbols.parameters_and_locals.applicable_accessibilities = *
dotnet_naming_style.camel_case.capitalization = camel_case
